{
  "name": "flowspace",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Native Multi-Tenant Team Task Workspace (MySQL + Express + React + Pusher + Groq)",
  "type": "module",
  "scripts": {
    "dev:server": "node --watch server/src/dev.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "npx concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "build": "npm --prefix client install && npm --prefix client run build",
    "db:setup": "node server/db/setup.js",
    "db:seed": "node server/db/seed.js",
    "test": "NODE_ENV=test DB_NAME=flowspace_test node --test server/tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "mysql2": "^3.11.5",
    "pusher": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "supertest": "^7.0.0"
  }
}
